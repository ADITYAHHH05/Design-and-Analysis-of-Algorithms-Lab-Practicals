#include <stdio.h>
#include <limits.h>
int main() {
    int n, amount;
    printf("Enter number of coin denominations: ");
    scanf("%d", &n);
    int coins[n];
    printf("Enter coin denominations:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &coins[i]);
        if (coins[i] <= 0) {
            printf("Coin denominations must be positive.\n");
            return 1;
        }
    }
    printf("Enter amount: ");
    scanf("%d", &amount);
    if (amount < 0) {
        printf("Amount cannot be negative.\n");
        return 1;
    }
    int dp[amount + 1];
    dp[0] = 0;
    for (int i = 1; i <= amount; i++) {
        dp[i] = INT_MAX;
    }
    for (int i = 1; i <= amount; i++) {
        for (int j = 0; j < n; j++) {

            if (coins[j] <= i &&
                dp[i - coins[j]] != INT_MAX) {

                int newCost = dp[i - coins[j]] + 1;

                if (newCost < dp[i]) {
                    dp[i] = newCost;
                }
            }
        }
    }

    if (dp[amount] == INT_MAX) {
        printf("Change cannot be made.\n");
    } else {
        printf("Minimum number of coins = %d\n",
               dp[amount]);
    }

    return 0;
}
