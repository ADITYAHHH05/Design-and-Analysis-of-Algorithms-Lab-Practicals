#include <stdio.h>
#include <stdlib.h>

struct Edge
{
    int u, v, w;
};

int parent[100];

int compare(const void *a, const void *b)
{
    struct Edge *e1 = (struct Edge *)a;
    struct Edge *e2 = (struct Edge *)b;

    return e1->w - e2->w;
}

int find(int x)
{
    if (parent[x] == x)
        return x;

    return parent[x] = find(parent[x]);
}

void unite(int a, int b)
{
    parent[find(a)] = find(b);
}

int main()
{
    int n, m;
    struct Edge e[100];

    printf("Enter number of vertices and edges: ");
    scanf("%d %d", &n, &m);

    printf("Enter edges (u v weight):\n");

    for (int i = 0; i < m; i++)
    {
        scanf("%d %d %d",
              &e[i].u, &e[i].v, &e[i].w);
    }

    qsort(e, m, sizeof(struct Edge), compare);

    for (int i = 0; i < n; i++)
        parent[i] = i;

    int cost = 0, count = 0;

    printf("\nEdges in Minimum Spanning Tree:\n");

    for (int i = 0; i < m; i++)
    {
        int u = e[i].u;
        int v = e[i].v;
        int w = e[i].w;

        if (find(u) != find(v))
        {
            printf("%d - %d : %d\n", u, v, w);

            cost += w;
            unite(u, v);
            count++;

            if (count == n - 1)
                break;
        }
    }

    if (count != n - 1)
        printf("Graph is not connected");
    else
        printf("\nMinimum cost = %d", cost);

    return 0;
}
